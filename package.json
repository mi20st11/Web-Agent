{
  "name": "web-agent",
  "version": "0.3.0",
  "description": "用网页版 DeepSeek / Gemini 当你电脑上的编程代理，零 API Key，零依赖。",
  "type": "module",
  "main": "web-agent.mjs",
  "bin": {
    "web-agent": "web-agent.mjs"
  },
  "scripts": {
    "start": "node web-agent.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/protocol.test.mjs\" \"test/policy.test.mjs\" \"test/exec.test.mjs\" \"test/git.test.mjs\" \"test/agent-git.test.mjs\" \"test/prompt.test.mjs\" \"test/site-continue.test.mjs\"",
    "build:exe": "node build/build-exe.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "AGPL-3.0-only",
  "private": false
}
